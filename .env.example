APP_NAME="Cool Boost"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-laravel-app.up.railway.app

SANCTUM_STATEFUL_DOMAINS=your-nextjs-app.vercel.app
SESSION_DRIVER=database
SESSION_DOMAIN=your-nextjs-app.vercel.app
SESSION_LIFETIME=120

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

